<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="450.0" styleClass="login-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.javafx.controller.ConnectController">
    <children>
        <VBox alignment="CENTER" fillWidth="true" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="EJP" styleClass="logo-text" />
                        <Label text="Chatroom" styleClass="logo-text-secondary" />
                    </children>
                </HBox>
                <Label text="连接服务器" styleClass="section-title" />
                <GridPane hgap="10.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="100.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="200.0" />
                    </columnConstraints>
                    <children>
                        <Label text="服务器地址:" styleClass="label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="serverAddressField" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="端口:" styleClass="label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="portField" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
                <Button fx:id="connectButton" text="连接" styleClass="btn-primary" />
                <Label fx:id="statusLabel" text="未连接" styleClass="status-label" />
            </children>
        </VBox>
    </children>
</AnchorPane>